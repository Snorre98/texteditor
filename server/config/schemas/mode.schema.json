{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://texteditor.local/schemas/mode.schema.json",
  "title": "Mode",
  "description": "A prompt preset: name + system prompt + default model (ADR-0045; behavioral fields removed).",
  "type": "object",
  "required": ["name", "systemPrompt", "defaultModel"],
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string",
      "description": "Unique; also the fallback modeTag."
    },
    "systemPrompt": {
      "type": "string",
      "description": "Fixed cost per turn."
    },
    "defaultModel": {
      "type": "string",
      "description": "Must resolve via the fleet manifest."
    }
  }
}
