# OS
.DS_Store

# Editors/IDEs
.vscode/
.idea/

# Environment
.env
.env.*

# Go build & test artifacts (module lives in server/, ADR-0034)
*.test
*.prof
coverage.out
/texteditor
/server/texteditor
/server/cmd/texteditor/texteditor

# Logs
*.log

# SQLite runtime files
*.db
*.db-wal
*.db-shm

# Engine runtime data (git history worktree, etc.)
/var/

# JS dependencies (client/, ADR-0034)
node_modules/

# Rust build artifacts (client/tauri, ADR-0034)
target/


# Bundled engine sidecar (built from server/, placed under src-tauri/binaries/
# with the target-triple suffix — ADR-0021 §1 "bundled, not installed").
client/tauri/src-tauri/binaries/

# Frontend build output (client/tauri, vite)
client/tauri/dist/
# Tauri-generated permission schemas (regenerated on first tauri build)
client/tauri/src-tauri/gen/
